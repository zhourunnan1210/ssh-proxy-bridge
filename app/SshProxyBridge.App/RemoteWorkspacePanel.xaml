<UserControl x:Class="SshProxyBridge.App.RemoteWorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="Microsoft YaHei UI, Microsoft YaHei"
             KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="28,20" Background="#172033">
            <StackPanel>
                <TextBlock Text="选择远程项目目录" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="SSH 验证成功。VS Code 将打开你选中的目录。"
                           Margin="0,6,0,0" Foreground="#CBD5E1" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,18,24,14" Padding="20" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="远程路径" Target="{Binding ElementName=PathBox}" Padding="0,0,0,7"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Grid Grid.Row="1" Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" MinHeight="37" Padding="9,5" VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrush}" KeyDown="PathBox_KeyDown" />
                    <Button x:Name="GoButton" Grid.Column="1" Margin="8,0,0,0" Content="转到"
                            Style="{StaticResource SecondaryButtonStyle}" Click="Go_Click" />
                    <Button x:Name="ParentButton" Grid.Column="2" Margin="8,0,0,0" Content="上一级"
                            Style="{StaticResource SecondaryButtonStyle}" Click="Parent_Click" IsEnabled="False" />
                </Grid>
                <ListBox x:Name="DirectoryList" Grid.Row="2" Padding="4"
                         AutomationProperties.Name="子目录" BorderBrush="{StaticResource BorderBrush}"
                         MouseDoubleClick="DirectoryList_MouseDoubleClick" KeyDown="DirectoryList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,18">
            <Button x:Name="ChooseBackButton" Content="返回" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
            <Button x:Name="ChooseFolderButton" Content="使用此目录并保存"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Choose_Click" />
        </StackPanel>
    </Grid>
</UserControl>
