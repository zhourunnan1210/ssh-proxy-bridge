<UserControl x:Class="SshProxyBridge.App.AddServerPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="StepCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#E2E8F0" />
        </Style>
        <Style x:Key="LoginModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#E8EEF7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="White" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#C9D8EC" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Segment" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="28,15">
            <StackPanel>
                <TextBlock Text="添加服务器" Foreground="White"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="填写连接信息并验证 SSH 登录" Foreground="#AFC0D8"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="32,14,32,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border x:Name="Step1Circle" Style="{StaticResource StepCircleStyle}">
                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>
                <TextBlock Text="服务器" Margin="8,6,0,0" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Height="2" Background="#CBD5E1" Margin="14,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border x:Name="Step2Circle" Style="{StaticResource StepCircleStyle}">
                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>
                <TextBlock Text="本机代理" Margin="8,6,0,0" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="3" Height="2" Background="#CBD5E1" Margin="14,0" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Border x:Name="Step3Circle" Style="{StaticResource StepCircleStyle}">
                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>
                <TextBlock Text="SSH 验证" Margin="8,6,0,0" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="28,8,28,12" Padding="24,15"
                Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="FormScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="Step1Panel">
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="6*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ServerNameLabel" Text="服务器名称"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ServerNameBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=ServerNameLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SSH 登录方式" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Height="36" Background="#EEF2F7" Padding="3"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="CommandLoginModeButton" Content="指令登录"
                                                         GroupName="SshLoginMode" Checked="LoginMode_Checked"
                                                         Style="{StaticResource LoginModeButtonStyle}" />
                                            <RadioButton x:Name="ManualLoginModeButton" Content="输入登录"
                                                         GroupName="SshLoginMode" IsChecked="True"
                                                         Checked="LoginMode_Checked"
                                                         Style="{StaticResource LoginModeButtonStyle}" />
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="ManualLoginPanel" Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SshHostLabel" Text="SSH 地址"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SshHostBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SshHostLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SshPortLabel" Text="端口"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SshPortBox" Text="22"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SshPortLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock x:Name="SshUserLabel" Text="SSH 用户"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SshUserBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SshUserLabel}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="CommandLoginPanel" Visibility="Collapsed" Margin="0,0,0,13">
                                <TextBlock x:Name="SshCommandLabel" Text="SSH 登录指令"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SshCommandBox" Height="54" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                                         AutomationProperties.LabeledBy="{Binding ElementName=SshCommandLabel}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="例如 " /><Run Text="ssh -p 2222 dev@server.example" FontFamily="Cascadia Mono, Consolas" />
                                    <LineBreak />
                                    <Run Text="粘贴同时含有指令和密码的登录信息时，密码会自动填到下方。" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock x:Name="SshPasswordLabel" Text="服务器密码"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <PasswordBox x:Name="SshPasswordBox" Height="36" Padding="10,6"
                                         AutomationProperties.LabeledBy="{Binding ElementName=SshPasswordLabel}"
                                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                            <CheckBox x:Name="SavePasswordCheckBox"
                                      Content="验证成功后保存到 Windows 凭据管理器"
                                      Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                            <TextBlock Text="Windows 本机代理" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="服务器无法直连时，使用此代理。"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,13" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="代理地址" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ProxyHostBox" Text="127.0.0.1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="代理端口" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ProxyPortBox" Text="7897" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="代理协议" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ProxyProtocolBox" SelectedIndex="0" Margin="0,0,0,16">
                                <ComboBoxItem Content="自动检测" Tag="Auto" />
                                <ComboBoxItem Content="HTTP" Tag="Http" />
                                <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                                <ComboBoxItem Content="Mixed" Tag="Mixed" />
                            </ComboBox>

                            <TextBlock Text="代理程序路径（可选）" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="ProxyExecutableBox" />
                            <CheckBox x:Name="ProxyAutoStartCheckBox" Content="代理未运行时自动启动"
                                      IsChecked="True" Margin="0,15,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                            <TextBlock Text="验证 SSH 登录" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="核对连接信息后，确认 SSH 主机指纹并验证密码。"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,13" />

                            <TextBlock Text="服务器代理端口" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="RemoteProxyPortBox" Text="17897" Margin="0,0,0,16" />

                            <TextBlock Text="SSH Key 模式" Style="{StaticResource FieldLabelStyle}" />
                            <RadioButton x:Name="OneClickKeyRadio" IsChecked="True" Margin="0,3,0,8">
                                <StackPanel>
                                    <TextBlock Text="一键模式" FontWeight="SemiBold" />
                                    <TextBlock Text="每台服务器使用独立无口令 Key，并通过当前用户 NTFS ACL 保护。"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ProtectedKeyRadio" Margin="0,3,0,16">
                                <StackPanel>
                                    <TextBlock Text="带口令模式" FontWeight="SemiBold" />
                                    <TextBlock Text="安全性更高，Windows 重启后可能需要重新解锁 ssh-agent。"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </RadioButton>

                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="14">
                                <TextBlock x:Name="ReviewText" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="ErrorBorder" Grid.Row="1" Visibility="Collapsed"
                        Background="#FEE2E2" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="#991B1B" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ActionBar" Grid.Row="3" Margin="28,0,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"
                    Margin="0,0,10,0" />
            <Button x:Name="BackButton" Grid.Column="2" Content="上一步"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click"
                    Visibility="Collapsed" Margin="0,0,10,0" />
            <Button x:Name="NextButton" Grid.Column="3" Content="下一步"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Next_Click" />
        </Grid>

        <Border x:Name="HostKeyConfirmOverlay" Grid.RowSpan="4" Panel.ZIndex="20"
                Visibility="Collapsed" Background="#B30F172A">
            <Border Width="560" Padding="24" Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="确认 SSH 主机身份" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="请通过云服务商控制台或服务器管理员提供的信息核对以下指纹。无法确认时请选择取消。"
                               Margin="0,8,0,16" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <TextBlock x:Name="HostKeyDetailsText" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                Click="RejectHostKey_Click" Margin="0,0,10,0" />
                        <Button Content="指纹正确，继续" Style="{StaticResource PrimaryButtonStyle}"
                                Click="TrustHostKey_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="WorkspacePickerOverlay" Grid.RowSpan="4" Panel.ZIndex="20"
                Visibility="Collapsed" Background="{StaticResource WindowBackgroundBrush}">
            <ContentControl x:Name="WorkspacePickerContent" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
